#!/bin/bash -e

# Use jemalloc to reduce memory fragmentation if available
JEMALLOC="/usr/lib/$(uname -m)-linux-gnu/libjemalloc.so.2"
if [ -f "$JEMALLOC" ] && [ -z "${DISABLE_JEMALLOC}" ]; then
  export LD_PRELOAD="${LD_PRELOAD:+$LD_PRELOAD:}$JEMALLOC"
else
  [ -n "${DISABLE_JEMALLOC}" ] \
    && echo "WARNING: jemalloc disabled via DISABLE_JEMALLOC" \
    || echo "WARNING: jemalloc not found at $JEMALLOC, skipping"
fi

# If running the rails server then create or migrate existing database
if [ "${1}" == "./bin/rails" ] && [ "${2}" == "server" ]; then
  # 2026-11-02 guard: db:prepare on a missing/empty database rebuilds it from
  # schema + seed (first boot). On an existing database with data it must NOT
  # run: only migrate. Without this, a boot into an empty database silently
  # reseeds and loses the previous contents (wipe incident 2026-11-02 19:44Z).
  if ./bin/rails runner 'exit(ActiveRecord::Base.connection.tables.empty? ? 0 : 1)' >/dev/null 2>&1; then
    ./bin/rails db:prepare
  else
    ./bin/rails db:migrate
  fi

  # Record which version migrated the database so the backup sidecar
  # (bin/sure-backup) can label backups without access to the Docker API.
  # A stale stamp would make the sidecar reject --version, so on any failure
  # remove it rather than leave the previous boot's values behind.
  stamp="storage/.sure-runtime"
  sure_version=$(tr -d '[:space:]' 2>/dev/null < .sure-version || true)
  sure_schema=$(sed -n 's/.*define(version: \([0-9_]*\)).*/\1/p' db/schema.rb 2>/dev/null | tr -d _ || true)
  if [ -z "${sure_version}" ] || [ -z "${sure_schema}" ] || ! {
    echo "SURE_VERSION=${sure_version}"
    echo "SURE_COMMIT=${BUILD_COMMIT_SHA}"
    echo "SURE_SCHEMA_VERSION=${sure_schema}"
    echo "SURE_STAMPED_AT=$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  } > "${stamp}.tmp" 2>/dev/null || ! mv "${stamp}.tmp" "${stamp}"; then
    rm -f "${stamp}" "${stamp}.tmp" 2>/dev/null || true
    echo "WARNING: could not write ${stamp}; backups will need --version"
  fi
fi

exec "${@}"
