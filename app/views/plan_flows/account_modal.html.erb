<%# "Add Account" modal (turbo frame): lists the family's already-known /
    synced accounts that are not yet on the map (pick -> added to the plan).
    NO own manual creation form: "Add Manual Account"
    goes to the house add-account page — every account comes from Sure's
    existing list. %>
<%= render DS::Dialog.new do |dialog| %>
  <% dialog.with_header(title: t(".title"), subtitle: t(".subtitle")) %>
  <% dialog.with_body do %>
    <div class="space-y-5">
      <div class="space-y-2">
        <p class="text-sm font-medium text-primary"><%= t(".existing_heading") %></p>
        <% if @unassigned_accounts.empty? %>
          <p class="text-xs text-secondary"><%= t(".all_on_map") %></p>
        <% end %>
        <%# In-place submit: fetch + tween the sankey
            (new banks grow in); the in-place submit handler also
            closes this modal frame on success. %>
        <%= form_with url: flow_add_accounts_plan_path, method: :post,
                      class: "space-y-2",
                      data: { turbo: "false", plan_flow_inplace: "true" } do |form| %>
          <%# the same LOCKED scroll window as the
              allocation dialog bank rows (max-h-64 overflow-y-auto —
              never overflow-auto) and the same BANK SOURCE row style:
              plan-flow avatar (logo over letter chip) + name +
              ****last4, the ONLY addition being the checkbox on the
              right (ml-auto). The "Add to map" submit button stays
              OUTSIDE the window. The row DOM order is the submission
              order that add_accounts uses to assign plan_order — the
              checkbox name/value (account_ids[]) are unchanged. %>
          <div class="max-h-64 overflow-y-auto space-y-1 overscroll-contain">
            <% @unassigned_accounts.each do |account| %>
              <label class="flex items-center gap-2 rounded-md px-2 py-1.5 cursor-pointer has-[:checked]:bg-surface-inset">
                <span class="h-8 w-8 flex-shrink-0 rounded-full overflow-hidden bg-subdued flex items-center justify-center relative">
                  <span class="text-sm font-medium text-secondary"><%= (account.name.to_s.strip.first || "?").upcase %></span>
                  <% if account.plan_flow_avatar_url.present? %>
                    <img src="<%= account.plan_flow_avatar_url %>" alt="" class="absolute inset-0 h-full w-full object-cover" onerror="this.remove()">
                  <% end %>
                </span>
                <span class="text-sm text-primary truncate"><%= account.name %></span>
                <%# The same last-4 the plan-flow
                    payload carries; nil for every account without a mask. %>
                <% if (last4 = @account_last4s[account.id]) %>
                  <span class="text-xs text-secondary tabular-nums">****<%= last4 %></span>
                <% end %>
                <input type="checkbox"
                       name="account_ids[]" value="<%= account.id %>"
                       class="checkbox checkbox--light h-4 w-4 rounded ml-auto" />
              </label>
            <% end %>
          </div>
          <% unless @unassigned_accounts.empty? %>
            <div class="pt-1">
              <%# bg-primary resolves to #171717 in the
                  dark theme — the modal's own background — so the button
                  was invisible. Dark-but-distinct surface + the exact
                  Add Manual Account border treatment. %>
              <button type="submit"
                      class="text-sm bg-surface-inset text-primary border border-subdued shadow-border-xs rounded-lg px-3 py-1.5 hover:opacity-90">
                <%= t(".add_selected") %>
              </button>
            </div>
          <% end %>
        <% end %>
      </div>

      <div class="space-y-2 border-t border-subdued pt-4">
        <p class="text-sm font-medium text-primary"><%= t(".manual_heading") %></p>
        <p class="text-xs text-secondary"><%= t(".manual_description") %></p>
        <%= link_to new_account_path,
              class: "inline-flex items-center gap-1 text-xs bg-container border border-subdued text-secondary rounded-lg px-2.5 py-1 shadow-border-xs hover:text-primary" do %>
          <%= icon("plus", class: "h-3 w-3") %><%= t(".manual_cta") %>
        <% end %>
      </div>
    </div>
  <% end %>
  <%# Cancel = the dialog's built-in close button (house pattern: submit
      buttons live in the body, e.g. trades/new.html.erb). %>
<% end %>
