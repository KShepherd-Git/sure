<%# Paycheck Flow (M2 PR#2b redesign): the planning diagram — incomes ->
    banks -> allocations as a Sankey in the house Cashflow style. Node
    vertical order is ALGORITHMIC (flow-weighted, stable, crossing-
    minimizing; no manual ordering UI, spec A2). Per Paycheck | Per Month
    is the house ?view= full-reload pattern. The diagram fetches
    GET /plan/flow/graph (build 1); the page embeds only static account
    names + in-plan membership — no client-side plan state. Removed with
    this rewrite: the plan_order selects, the Home/Shared column dropdown,
    the edge editor, the obligations column, and the old resolved panel
    (the resolved numbers now live in the Sankey + tooltips). %>
<div class="@container space-y-6 pb-6 lg:pb-12"
     data-controller="plan-flow"
     data-plan-flow-recommendations-value="<%= @graph[:recommendations].to_json %>"
     data-plan-flow-in-plan-value="<%= @in_plan_account_ids.to_json %>">
  <header>
    <div class="flex items-center gap-2">
      <h1 class="text-2xl font-semibold text-primary"><%= t(".title") %></h1>
      <%= render DS::Pill.new(label: t("shared.preview"), size: :md) %>
    </div>
    <p class="text-sm text-secondary mt-1">
      <%= t(".subtitle", month: l(@month, format: :month_year)) %>
    </p>
  </header>

  <div class="flex items-center justify-between gap-3 flex-wrap">
    <div class="flex items-center gap-3">
      <%# R35 (Flow Scenarios, design §4.1) / R35b: the Flow Scenario
          picker — the FIRST item of the toggle row (moved here from the
          standalone right-aligned row above). The trigger renders inside
          the house segmented-control track (the same .segmented-control
          bg-surface-inset container as the Per Paycheck / Per Month +
          Manage / View pills: same background, border, height, radius,
          font). Default state labels the live plan ("Flow Scenario:
          Default"); an active scenario labels its name with the --active
          segment styling. No :scenario param means the page is
          byte-identical to the pre-R35 one beyond this row. %>
      <%= render "plan_flows/scenario_picker", scenarios: @scenarios, active: @scenario %>

      <%# Round 33 (spec 3): Per Paycheck <-> Per Month is now an IN-PLACE
          toggle (plain buttons, no href — same house pattern as the
          Manage/View sizing mode below): the sankey controller's
          document-level delegation flips the active segment, morphs ONLY
          the dollar values in place (tween + the value-label blur/fade),
          PRESERVES the current Manage or View sizing mode (it used to
          full-reload, which reset the mode to Manage), and persists the
          choice as ?view= via replaceUrl (no history entry, no request).
          The unit choice rides along: ?paycheck_unit= is kept/set by the
          same replaceUrl, and the server-rendered segments above honor
          ?view= on any full reload. %>
      <%= render DS::SegmentedControl.new(aria_label: t(".view_aria"), class: "bg-surface-inset") do |control| %>
        <% control.with_segment(t(".view_paycheck"), active: @view == "paycheck", data: { plan_flow_sankey_view: "paycheck" }) %>
        <% control.with_segment(t(".view_monthly"), active: @view == "monthly", data: { plan_flow_sankey_view: "monthly" }) %>
      <% end %>

      <%# Issue 10 (View/Manage): the diagram sizing-mode toggle — styled
          and positioned like the view toggle above (same component, same
          row). Plain buttons, no href: unlike the ?view= reload toggle,
          the sankey controller re-renders the diagram IN PLACE and flips
          the active segment (no page reload — the mode never changes the
          data). MANAGE is the default on load = the current behavior. %>
      <%= render DS::SegmentedControl.new(aria_label: t(".mode_aria"), class: "bg-surface-inset") do |control| %>
        <% control.with_segment(t(".mode_manage"), active: true, data: { plan_flow_sankey_mode: "manage" }) %>
        <% control.with_segment(t(".mode_view"), active: false, data: { plan_flow_sankey_mode: "view" }) %>
      <% end %>

      <%# Round 33 (spec 2): the paycheck-unit kebab — RIGHT of the
          Manage/View segmented control. The Per Paycheck divisor choice:
          per income occurrence (DEFAULT — each Per Paycheck figure
          divides by how many times THAT income lands in the month) or the
          old family composite (divide by the month's total paycheck
          count). House DS::Menu (icon trigger, selectable menuitemradio
          rows); the sankey controller's document-level delegation
          intercepts the item links IN PLACE (capture-phase, before
          Turbo), morphs the values, and persists ?paycheck_unit= via
          replaceUrl — the hrefs keep a no-JS full-reload fallback. The
          check gutter flips client-side (see #updateUnitToggleUI). %>
      <%# R35c (owner spec): the kebab + the two compact hover icons share ONE
          flex unit (gap-2 = 8px between kebab / yellow / red); the row's own
          gap-3 still separates the Manage/View toggle from the kebab. %>
      <div class="flex items-center gap-2">
        <%= render DS::Menu.new(variant: "icon", placement: "bottom-start", icon_vertical: true) do |menu| %>
          <% menu.with_item(variant: "link", text: t(".unit_income"), selected: @paycheck_unit == "income", href: flow_plan_path(view: @view, paycheck_unit: "income"), data: { plan_flow_sankey_unit: "income" }) %>
          <% menu.with_item(variant: "link", text: t(".unit_family"), selected: @paycheck_unit == "family", href: flow_plan_path(view: @view, paycheck_unit: "family"), data: { plan_flow_sankey_unit: "family" }) %>
        <% end %>

        <%# R35c (owner spec): the SCENARIO info icon — replaces the amber
            banner strip (R35c removed it from _chrome_top.erb). One "i" in a
            circle (lucide info), amber, 18px in a 28px row slot, vertically
            centered. Pure CSS hover (group / group-hover — NO JS listeners,
            round-28 float rule): the popup floats ABOVE the icon, right edge
            aligned (right-0) so it extends LEFT into open space (the legend
            sits at the far right of the row). The pt-2 bridge span makes the
            8px gap part of the hoverable DOM so the mouse can travel from
            icon into popup without a dead zone; the popup carries the exact
            banner text + the same Back to live plan link (same message,
            same exit path). Visible only while a scenario is active. %>
        <% if @scenario %>
          <span class="relative group inline-flex h-7 w-7 items-center justify-center"
                aria-label="<%= t('.aria_scenario') %>">
            <svg class="h-[18px] w-[18px] text-amber-500 theme-dark:text-amber-400"
                 viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="10"/>
              <path d="M12 16v-4"/>
              <path d="M12 8h.01"/>
            </svg>
            <span class="absolute right-0 bottom-full z-50 hidden group-hover:block">
              <span class="block pt-2">
                <span class="block w-max max-w-[400px] rounded-lg border border-amber-300 bg-amber-50 px-3 py-2 text-xs text-amber-900 shadow-md theme-dark:border-amber-800 theme-dark:bg-amber-950 theme-dark:text-amber-100">
                  <%= t(".scenario_banner", name: @scenario.name) %>
                  <a href="<%= flow_plan_path %>"
                     class="mt-1.5 inline-block text-sm font-medium underline hover:opacity-75">
                    <%= t(".scenario_back") %>
                  </a>
                </span>
              </span>
            </span>
          </span>
        <% end %>

        <%# R35c (owner spec): the PLAN ISSUES icon — replaces the red line
            groups (R35c removed the over-plan + Un-Allocated line groups
            from _chrome_top.erb; same locals, same t() calls, same order:
            over-plan lines first, then the Un-Allocated discrepancies).
            Caution "!" line icon (lucide triangle-alert, stroke style),
            theme-aware red (text-destructive: red-500 light / red-400
            dark). Same pure-CSS hover pattern as the yellow icon: popup
            above, right-aligned, extends left, pt-2 bridge. One list item
            per red line, the exact current line text. Visible only while at
            least one red line exists. %>
        <% if @over_plan_lines.any? || @discrepancy_lines&.any? %>
          <span class="relative group inline-flex h-7 w-7 items-center justify-center"
                aria-label="<%= t('.aria_discrepancies') %>">
            <svg class="h-[18px] w-[18px] text-destructive"
                 viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 20h16a2 2 0 0 0 1.73-2Z"/>
              <path d="M12 9v4"/>
              <path d="M12 17h.01"/>
            </svg>
            <span class="absolute right-0 bottom-full z-50 hidden group-hover:block">
              <span class="block pt-2">
                <span class="block w-max max-w-[400px] rounded-lg border border-red-300 bg-red-50 px-3 py-2 text-xs text-red-900 shadow-md theme-dark:border-red-800 theme-dark:bg-red-950 theme-dark:text-red-100">
                  <ul class="space-y-1">
                    <% @over_plan_lines.each do |line| %>
                      <li>
                        <%= t(".over_plan",
                              amount: number_to_currency(line[:amount], currency: Current.family.currency),
                              income: line[:income],
                              item: line[:item]) %>
                      </li>
                    <% end %>
                    <% @discrepancy_lines&.each do |line| %>
                      <li>
                        <%= t(".un_allocated",
                              income: line[:income],
                              amount: number_to_currency(line[:amount], currency: Current.family.currency)) %>
                      </li>
                    <% end %>
                  </ul>
                </span>
              </span>
            </span>
          </span>
        <% end %>
      </div>
    </div>

    <%# The color language (spec §2): income green / spending amber / debt
        red / savings blue (owner round 3, R4) / surplus green /
        unallocated half-tone. %>
    <div class="hidden md:flex items-center gap-4 text-xs text-secondary">
      <span class="flex items-center gap-1.5"><span class="h-2.5 w-2.5 rounded-sm bg-[#10A861]"></span><%= t(".legend_income") %></span>
      <span class="flex items-center gap-1.5"><span class="h-2.5 w-2.5 rounded-sm bg-[#9E9E9E]"></span><%= t(".legend_banks") %></span>
      <span class="flex items-center gap-1.5"><span class="h-2.5 w-2.5 rounded-sm bg-[#EAB308]"></span><%= t(".legend_spending") %></span>
      <span class="flex items-center gap-1.5"><span class="h-2.5 w-2.5 rounded-sm bg-[#EC2222]"></span><%= t(".legend_debt") %></span>
      <span class="flex items-center gap-1.5"><span class="h-2.5 w-2.5 rounded-sm bg-[#2563EB]"></span><%= t(".legend_savings") %></span>
      <span class="flex items-center gap-1.5"><span class="h-2.5 w-2.5 rounded-sm bg-[#10A861]"></span><%= t(".legend_surplus") %></span>
    </div>
  </div>

  <%# R35c (owner spec): the former chrome-top line groups moved — the
      amber scenario banner (R35) and the red line groups (the over-plan
      lines + the R31A Un-Allocated discrepancies) now live as compact
      hover icons in the toggle row above (right of the kebab, fed from the
      same @scenario / @over_plan_lines / @discrepancy_lines locals). The
      red node styling is still drawn by the Sankey from the same graph
      data. The chrome partial now ships only the C14 amber drift prompt;
      the in-place JSON swaps (owner round 3, R1/R7) re-render it as
      before. %>
  <%= render "plan_flows/chrome_top" %>

  <div class="relative rounded-xl bg-container shadow-border-xs overflow-hidden">
    <%# Column action buttons (owner round 2, F2: replace the black SVG
        column headers). + Add Income -> the house income/payroll page;
        + Add Account -> the known-accounts popup; + Add Allocation -> the
        dialog. Same styling as the floating Add Allocation button. %>
    <div class="absolute left-3 top-2 z-10">
      <%= link_to bills_path(view: "paycheck"),
            class: "flex items-center gap-1 text-xs bg-container border border-subdued text-secondary rounded-lg px-2.5 py-1 shadow-border-xs hover:text-primary" do %>
        <%= icon("plus", class: "h-3 w-3") %><%= t(".add_income") %>
      <% end %>
    </div>
    <%# Owner round 3, R5: Add Account matches the Add Income / Add
        Allocation buttons exactly (same classes; the DS::Link outline
        variant was taller). Same modal frame as before. %>
    <div class="absolute left-1/2 -translate-x-1/2 top-2 z-10">
      <%= link_to flow_add_accounts_modal_plan_path,
            class: "flex items-center gap-1 text-xs bg-container border border-subdued text-secondary rounded-lg px-2.5 py-1 shadow-border-xs hover:text-primary",
            data: { turbo_frame: "modal" } do %>
        <%= icon("plus", class: "h-3 w-3") %><%= t(".add_account") %>
      <% end %>
    </div>
    <%# The diagram. The Sankey controller fetches /plan/flow/graph and
        draws it; the embedded maps are static (names + in-plan membership),
        never plan state.
        Round 16 (owner notes A/B, 2026-11-07): the wrapper is min-height
        (not a fixed height) so the PAGE GROWS when the MANAGE label floors
        grow the chart (the owner accepts the vertical page scroll — no
        clipping), and overflow-x:auto so the MANAGE min-width diagram (the
        zero-label-overlap width the controller computes) scrolls
        horizontally instead of squeezing the labels. VIEW is unaffected:
        its svg fits the container width exactly, so no scrollbar appears. %>
    <div style="min-height: 480px; overflow-x: auto"
         data-controller="plan-flow-sankey"
         <%# R35 (Flow Scenarios): the sankey fetches this exact URL, so an
             active scenario rides along as ?scenario= — zero JS change.
             Default (no active scenario) renders the bare path, byte-
             identical to the pre-R35 attribute (Rails drops nil params). %>
         data-plan-flow-sankey-graph-url-value="<%= flow_graph_plan_path(scenario: @scenario&.id) %>"
         data-plan-flow-sankey-view-value="<%= @view %>"
         data-plan-flow-sankey-mode-value="manage"
         <%# Round 33: the active Per-Paycheck unit (income | family).
             Toggled in place by the paycheck-unit kebab; ?paycheck_unit=
             persists through replaceUrl and any full reload. %>
         data-plan-flow-sankey-unit-value="<%= @paycheck_unit %>"
         data-plan-flow-sankey-currency-value="<%= Current.family.currency %>"
         data-plan-flow-sankey-accounts-value="<%= @account_names.to_json %>"
         data-plan-flow-sankey-in-plan-value="<%= @sankey_in_plan_ids.to_json %>"
         data-plan-flow-sankey-labels-value="<%= { "income" => t(".column_incomes"), "bank" => t(".column_banks"), "allocation" => t(".column_allocations"), "surplus" => t(".surplus_node"), "unallocated" => t(".unallocated_node"), "unassigned" => t(".unassigned_node"), "error" => t(".chart_error"), "empty" => t(".chart_empty") }.to_json %>">
    </div>

    <%# Round 31B (Direct Deposit): the bottom action row — the Direct
        Deposit Review entry point (B1 label, verbatim; the pill pattern
        from the segmented-control CSS). Both View and Manage sizing
        modes; opens the paycheck-config dialog (one tab per existing
        member, B3). %>
    <div class="flex items-center gap-2 px-3 pb-2">
      <button type="button"
              class="segmented-control__segment focus-ring"
              data-action="plan-flow#openPaycheckConfig">
        <%= t(".direct_deposit_review") %>
      </button>
    </div>

    <%# The absolutely-positioned chrome (banks empty state, allocations
        empty state + Recommended, no-incomes note): server-rendered via
        the chrome partial so in-place JSON updates (owner round 3,
        R1/R7) can swap it without a reload. %>
    <%= render "plan_flows/chrome_overlays" %>
  </div>

  <%# Dialogs (house DS::Dialog, opened by node click / buttons). Saves are
      in-place fetches (owner review round 3, R1/R7: data-turbo off + the
      in-place submit handler) — the diagram tweens to the new
      graph, no full reload. %>
  <% @in_plan_accounts.each do |account| %>
    <% edges = Current.family.income_account_allocations.where(account: account).index_by(&:income_series_id) %>
    <%= render "plan_flows/bank_config_dialog",
               account: account, edges: edges, available_bank_logos: @available_bank_logos,
               view: @view,
               # Round 27 (owner item 4): the read-only dialog context —
               # the required base in the active view unit + the per-income
               # amounts for the client-side auto-fill and ratio
               # re-derivation (never submitted).
               required_display_amount: (@bank_required_display || {})[account.id],
               income_amounts: @income_display_amounts,
               # Round 30: the per-income required-split readouts (greyed
               # 50/50 / Proportional readouts + the stored percents behind
               # the Percent behavior's inputs).
               required_splits: (@bank_required_splits || {})[account.id],
               # Round 33: the active paycheck unit (the dialog's hidden
               # paycheck_unit input — in-place saves re-render the
               # readouts in the selected unit).
               paycheck_unit: @paycheck_unit,
               # Round 34 (spec 3): the Leftover guardrail — income series
               # id -> the account id of its existing leftover edge. The
               # dialog greys the "Leftover" option for a member's other
               # allocations when that paycheck already has a leftover edge
               # to a different account.
               leftover_accounts: @leftover_accounts %>
  <% end %>
  <% @income_series.each do |series| %>
    <%= render "plan_flows/income_config_dialog", series: series %>
  <% end %>
  <%# Round 31B (Direct Deposit): the Direct Deposit Review dialog — one
      tab per existing family member (B3), in-place saves (the shared
      #inPlaceSubmit handler), derived monthly + next-4 readouts. The
      dialog re-renders through the in-place chrome after a save. %>
  <%= render "plan_flows/paycheck_config_dialog", tabs: @paycheck_config_tabs, month: @month %>
  <%= render "plan_flows/allocation_dialog", allocation: nil, known_allocations: @known_allocations,
        known_hidden: @known_allocations_hidden %>
  <%# Round 21 T4: the "selected allocation" window — the SAME partial a
      second time (allocation nil, show_known: false so the known list and
      its CTA live ONLY in allocation:new; the in-place known-list swap
      keeps a single [data-plan-flow-target='knownSection'] holder).
      openKnownAllocation prefills THIS dialog's form and showModal()s it.
      It carries the bank-rows holder, so #inPlaceSubmit's R1 fragment
      swap re-checks its radios too. %>
  <%= render "plan_flows/allocation_dialog", allocation: nil,
        node_id: "allocation:selected", show_known: false %>
  <% @plan_allocations.each do |allocation| %>
    <%= render "plan_flows/allocation_dialog", allocation: allocation %>
  <% end %>
</div>
