<%# the Flow Scenario picker — the house
    DS::Popover pattern (DS::Popover is the mixed-content panel; DS::Menu
    is strictly flat action lists). The Default row is immutable (the live
    plan — no rename / delete / reset affordance); each scenario row
    carries its name + the RESET / rename / delete affordances (icon
    buttons — the plan-flow controller's window.confirm / window.prompt
    handlers: browser dialogs on a user gesture, not document-level
    listeners; element-scoped queries).
    Selecting a row is a PLAIN LINK -> a full page load (the house
    navigation for a mode switch, not in-place): Default goes to the bare
    flow path (byte-identical URL — no trailing empty ?scenario= param),
    a scenario to ?scenario=<id>. "Create New Scenario…" opens the create
    dialog (_scenario_new_dialog.erb).
    locals: scenarios (PlanScenarios order created_at), active (@scenario, nil = Default)
    data-scenario-picker + data-scenario-flow-path scope the picker for the
    controller handlers (the element-scoped query contract). %>
<%# The picker is the FIRST item of the show toggle row — the trigger
    sits inside the house segmented-control track (the same container the
    Per Paycheck / Per Month + Manage / View pills use: .segmented-control
    bg-surface-inset = inline-flex, p-1, rounded-lg, inset background), so
    the pill reads as a sibling of the view/mode toggles. The popover panel
    is position:fixed (floating-ui, viewport-relative), so the track
    nesting does not affect placement. %>
<div class="segmented-control bg-surface-inset"
     role="group"
     aria-label="<%= t("plan_flows.show.scenario_aria") %>"
     data-scenario-picker data-scenario-flow-path="<%= flow_plan_path %>">
<%= render DS::Popover.new(variant: "button", no_padding: true, placement: "bottom-end") do |popover| %>
  <%# The trigger — the house segmented-control segment inside the track.
      Default state: "Flow Scenario: Default" (the live plan); an active
      scenario: its name + the --active segment styling (the design).
      The chevron-down marks the dropdown. %>
  <% scenario_trigger_class = "segmented-control__segment focus-ring" + (active ? " segmented-control__segment--active" : "") %>
  <% popover.with_button(class: scenario_trigger_class, data: { scenario_trigger: "true" }) do %>
    <span class="text-sm font-medium">
      <%= active ? t("plan_flows.show.scenario_picker_active", name: active.name) : t("plan_flows.show.flow_scenario") %>
    </span>
    <%= icon("chevron-down", size: "xs", color: "current") %>
  <% end %>
  <% popover.with_custom_content do %>
    <div class="p-1">

      <%# The Default row — immutable (the live plan; no affordances). %>
      <a href="<%= flow_plan_path %>"
         class="flex items-center gap-2 px-2 py-1.5 rounded-lg <%= "bg-muted" if active.nil? %> hover:bg-muted text-sm">
        <span class="flex-1 flex items-center gap-1.5">
          <span class="font-medium"><%= t("plan_flows.show.scenario_default") %></span>
          <span class="text-xs text-secondary bg-subdued rounded px-1"><%= t("plan_flows.show.scenario_live_badge") %></span>
        </span>
      </a>

      <% scenarios.each do |s| %>
        <div class="flex items-center gap-1" data-scenario-row data-scenario-row-id="<%= s.id %>" data-scenario-row-name="<%= s.name %>">
          <a href="<%= flow_plan_path(scenario: s.id) %>"
             class="flex-1 flex items-center gap-2 px-2 py-1.5 rounded-lg <%= "bg-muted" if active&.id == s.id %> hover:bg-muted text-sm">
            <span class="flex-1 truncate" data-scenario-row-name-label><%= s.name %></span>
          </a>
          <button type="button"
                  class="p-1 rounded text-secondary hover:text-primary hover:bg-subdued focus-ring"
                  title="<%= t('plan_flows.show.scenario_reset') %>"
                  data-action="click->plan-flow#resetScenario"
                  data-scenario-reset-url="<%= flow_scenario_reset_plan_path(s.id) %>"
                  data-scenario-reset-name="<%= s.name %>"
                  data-scenario-reset-confirm="<%= t('plan_flows.show.scenario_reset_confirm', name: s.name) %>">
            <%= icon("rotate-ccw", class: "h-3.5 w-3.5") %>
          </button>
          <button type="button"
                  class="p-1 rounded text-secondary hover:text-primary hover:bg-subdued focus-ring"
                  title="<%= t('plan_flows.show.scenario_rename') %>"
                  data-action="click->plan-flow#renameScenario"
                  data-scenario-rename-url="<%= flow_scenario_rename_plan_path(s.id) %>"
                  data-scenario-rename-name="<%= s.name %>"
                  data-scenario-rename-title="<%= t('plan_flows.show.scenario_rename') %>">
            <%= icon("pencil", class: "h-3.5 w-3.5") %>
          </button>
          <button type="button"
                  class="p-1 rounded text-secondary hover:text-destructive hover:bg-subdued focus-ring"
                  title="<%= t('plan_flows.show.scenario_delete') %>"
                  data-action="click->plan-flow#deleteScenario"
                  data-scenario-delete-url="<%= flow_scenario_destroy_plan_path(s.id) %>"
                  data-scenario-delete-name="<%= s.name %>"
                  data-scenario-delete-confirm="<%= t('plan_flows.show.scenario_delete_confirm', name: s.name) %>"
                  data-scenario-delete-active="<%= active&.id == s.id %>">
            <%= icon("trash-2", class: "h-3.5 w-3.5") %>
          </button>
        </div>
      <% end %>

      <div class="border-t border-subdued my-1"></div>
      <button type="button"
              class="w-full px-2 py-1.5 rounded-lg text-sm text-primary hover:bg-muted text-left focus-ring"
              data-action="click->plan-flow#openScenarioNew">
        <%= t("plan_flows.show.scenario_new") %>
      </button>
    </div>
  <% end %>
<% end %>
<%# the create dialog — name + source (Start Fresh? /
    Re-Use Current). POST flow_scenario_create; success is a 303 -> full
    page load into the NEW scenario (the house navigation for a mode
    switch); a 422 comes back as a house flash alert (the model's field
    messages). MUST render inside the picker container: the
    openScenarioNew handler is element-scoped to [data-scenario-picker]
    (no document-level queries), so a dialog outside this div
    would never open. %>
<%= render "plan_flows/scenario_new_dialog" %>
</div>
