<%# Income node -> config dialog: label the income to a family
    member (blank = falls back to the account holder), the hard bank-link limit
    (plan_max_account_links, blank = unlimited; plan-time amber warning
    when exceeded, spec A4), and the link to the house Add-Family-Member
    page (Profile settings -> Household). Submits the PATCH flow_income
    endpoint. Full reload on save.
    locals: (series) — the declared income series %>
<%= render DS::Dialog.new(auto_open: false, disable_frame: true,
      data: { node_id: "income:#{series.id}" }) do |dialog| %>
  <% dialog.with_header(title: t(".title", name: series.name), subtitle: t(".subtitle")) %>
  <% dialog.with_body do %>
    <%# In-place validation errors: the 422 response
        renders them here — no full-reload flash for in-place submits. %>
    <div data-in-place-errors class="hidden space-y-1"></div>
    <%# In-place submit: data-turbo off + the
        the in-place submit handler — the diagram tweens to the
        new graph instead of a full reload destroying it. %>
    <%= form_with url: flow_income_plan_path(series.id), method: :patch, scope: :series,
                  class: "space-y-5",
                  data: { turbo: "false", plan_flow_inplace: "true" } do |form| %>
      <%# the hidden scenario field —
          rendered when a scenario is active so the in-place PATCH stays
          scoped (load_scenario reads params[:scenario]); absent = the
          live path, byte-identical Default DOM. %>
      <%= hidden_field_tag :scenario, @scenario.id if @scenario %>
      <% if @scenario %>
        <%# Scenario mode (the design): the income-policy override — enabled /
            zeroed / gross — writes the snapshot's income-policy row. The live
            structural fields (account holder / max links) are NOT scenario-editable
            (they stay live). %>
        <% policy_row = (@scenario.snapshot["incomes"] || []).find { |r| r["series_id"] == series.id } %>
        <% enabled = policy_row ? policy_row["enabled"] != false : true %>
        <% zeroed  = policy_row ? policy_row["zeroed"] == true : false %>
        <% gross   = policy_row && policy_row["gross_per_paycheck_cents"] ? (policy_row["gross_per_paycheck_cents"] / 100.0) : nil %>
        <div class="space-y-1">
          <label class="flex items-center gap-2 text-sm">
            <input type="hidden" name="income_policy[enabled]" value="false">
            <input type="checkbox" name="income_policy[enabled]" value="true"
                   <%= "checked" if enabled %> class="h-4 w-4 accent-primary">
            <%= t(".enabled_label") %>
          </label>
        </div>
        <div class="space-y-1">
          <label class="flex items-center gap-2 text-sm">
            <input type="checkbox" name="income_policy[zeroed]" value="true"
                   <%= "checked" if zeroed %> class="h-4 w-4 accent-primary">
            <%= t(".zeroed_label") %>
          </label>
        </div>
        <div class="space-y-1">
          <label class="block text-xs text-secondary" for="income_policy_gross"><%= t(".gross_label") %></label>
          <input type="text" id="income_policy_gross" name="income_policy[gross]"
                 value="<%= gross %>" placeholder="<%= t('.gross_placeholder') %>"
                 class="text-sm border border-primary rounded-lg px-2 py-1.5 bg-container text-primary w-full tabular-nums">
          <p class="text-xs text-secondary"><%= t(".gross_hint") %></p>
        </div>
      <% else %>
      <div class="space-y-1">
        <%= form.label :plan_owner_user_id, t(".owner_label"), class: "block text-xs text-secondary" %>
        <%= form.select :plan_owner_user_id,
                        options_for_select([[ t(".owner_fallback"), "" ]] + @family_users.map { |user| [ user.display_name, user.id ] },
                                            series.plan_owner_user_id),
                        {}, class: "text-sm border border-primary rounded-lg px-2 py-1.5 bg-container text-primary w-full" %>
      </div>

      <div class="space-y-1">
        <%= form.label :plan_max_account_links, t(".max_links_label"), class: "block text-xs text-secondary" %>
        <%= form.number_field :plan_max_account_links,
                              value: series.plan_max_account_links,
                              min: 1,
                              placeholder: t(".max_links_placeholder"),
                              class: "text-sm border border-primary rounded-lg px-2 py-1.5 bg-container text-primary w-full tabular-nums" %>
        <p class="text-xs text-secondary"><%= t(".max_links_hint") %></p>
      </div>

      <div class="border-t border-subdued pt-3">
        <%= link_to settings_profile_path, class: "inline-flex items-center gap-1 text-sm text-primary hover:underline" do %>
          <%= icon("plus", class: "h-3.5 w-3.5") %>
          <%= t(".add_family_member") %>
        <% end %>
      </div>
      <% end %>

      <div class="flex justify-end pt-1">
        <%# In-place save: see the form's data-action. %>
        <button type="submit"
                class="text-sm bg-primary text-on-primary rounded-lg px-3 py-1.5 hover:opacity-90">
          <%= t(".save") %>
        </button>
      </div>
    <% end %>
  <% end %>
<% end %>
