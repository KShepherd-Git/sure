<%# The "Known Allocations" list (owner round 2, F3; round 8) for the
    new-allocation dialog: the family's detected bills / subscriptions that
    are NOT already in the diagram — an allocation that links a detected
    bill keeps it out of this list (owner: "it only lists Known Allocations
    that are not already in the Diagram"). Extracted so the in-place
    allocation updates (owner round 3, R1/R7) can refresh it without a full
    reload.
    locals: (known_allocations, known_hidden = false) — known_hidden is
    true when at least one detected bill is already planned (so an empty
    list can say "all in the diagram" instead of "nothing detected").
    i18n keys are explicit (plan_flows.allocation_dialog.*) — a partial's
    lazy scope is its own name. %>
<div class="space-y-2" data-plan-flow-target="knownSection">
  <p class="text-sm font-medium text-primary"><%= t("plan_flows.allocation_dialog.known_heading") %></p>
  <% if known_allocations.blank? %>
    <p class="text-xs text-secondary"><%= known_hidden ? t("plan_flows.allocation_dialog.known_all_planned") : t("plan_flows.allocation_dialog.known_empty") %></p>
  <% end %>
  <%# Round 21 T3: the list is a shorter sub-section inside the dialog (the
      container around this partial is a darker, less-tall inset), so the
      scroll cap comes down a step. %>
  <ul class="space-y-1 max-h-40 overflow-y-auto pr-1">
    <% known_allocations.each do |known| %>
      <li>
        <button type="button"
                class="w-full flex items-center justify-between gap-2 text-left text-sm rounded-lg px-2 py-1.5 hover:bg-surface-inset"
                data-action="plan-flow#openKnownAllocation"
                data-known-id="<%= known[:id] %>"
                data-known-name="<%= known[:name] %>"
                data-known-amount-cents="<%= known[:amount_cents].to_i %>"
                data-known-cadence="<%= known[:cadence] %>"
                data-known-account="<%= known[:account_id] %>">
          <span class="truncate text-primary"><%= known[:name] %></span>
          <span class="flex items-center gap-2 shrink-0">
            <% if known[:amount_cents].to_i.positive? %>
              <span class="text-xs text-secondary tabular-nums"><%= number_to_currency(known[:amount_cents] / 100.0, currency: Current.family.currency) %>/mo</span>
            <% end %>
            <% if known[:cadence].present? %>
              <span class="text-xs text-secondary"><%= t("plan_flows.allocation_dialog.cadence_#{known[:cadence]}") %></span>
            <% end %>
          </span>
        </button>
      </li>
    <% end %>
  </ul>
</div>
