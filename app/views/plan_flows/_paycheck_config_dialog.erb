<%# (Direct Deposit) -> : the Direct Deposit Review dialog
    (opened by the bottom action row's button, plan-flow#openPaycheckConfig).
    One tab per EXISTING family member. The dialog is now a
    STATIC READ-ONLY paycheck readout — the config form (gross / frequency /
    anchor / Save) is gone. Each panel shows:
      * the header line "<Member> Paycheck" (t(".header")),
      * the max-direct-deposit-connections note (server-rendered from the
        member's payroll income series' plan_max_account_links — a SERIES-
        level field on recurring_transactions, NOT on the account or member;
        the requirement was to check accounts/family first: it is absent there),
      * a read-only series context line, and
      * a "Account | Direct Deposit Amount" table whose rows are rendered
        CLIENT-SIDE from /plan/flow/graph (one row per account this member's
        paycheck funds in the current plan; PER-PAYCHECK amounts; the leftover
        row carries the leftover icon + the computed value).
    The family_paycheck_configs table / model / PATCH endpoint remain in
    place (harmless, unused by this UI now — the readout derives from the
    live plan, not from stored paycheck configs).
    locals: (tabs, month) — one hash per member:
      { member:, series: (or nil), config: (or nil),
        derived_monthly_cents: (or nil), upcoming: [Date] } %>
<%= render DS::Dialog.new(auto_open: false, disable_frame: true, width: "lg",
      data: { node_id: "paycheck-config", controller: "plan-flow-paycheck-config",
              paycheck_currency: Current.family.currency }) do |dialog| %>
  <% dialog.with_header(title: t(".title"),
                        subtitle: t(".subtitle", month: l(month, format: :month_year))) %>
  <% dialog.with_body do %>
    <%# In-place validation errors: kept for the (now unused) in-place path. %>
    <div data-in-place-errors class="hidden space-y-1"></div>

    <%# Scoped fallback so the tab labels stay on ONE line
        even if the Tailwind whitespace-nowrap utility is purged (the labels
        are generated by DS::Tabs; this targets them directly). %>
    <style>
      .dd-review-tab-label { white-space: nowrap; }
    </style>

    <%= render DS::Tabs.new(active_tab: tabs.first ? tabs.first[:member].id.to_s : nil) do |tabs_component| %>
      <% tabs_component.with_nav(classes: "max-w-fit") do |nav| %>
        <% tabs.each do |tab| %>
          <%# Keep the member name on ONE line (long member
              names used to wrap at wide viewports). whitespace-nowrap keeps
              it single-line (a scoped fallback style below covers the case
              where the utility is purged). %>
          <% nav.with_btn(id: tab[:member].id.to_s, label: tab[:member].display_name, classes: "px-4 whitespace-nowrap dd-review-tab-label") %>
        <% end %>
      <% end %>

      <% tabs.each do |tab| %>
        <% tabs_component.with_panel(tab_id: tab[:member].id.to_s) do %>
          <% if tab[:series].nil? %>
            <%# Empty state: the member has no labeled income series yet.
                No readout, no rows — the series must be labeled first (the
                bills paycheck page is the house labeling surface). %>
            <p class="text-sm text-secondary">
              <%= t(".no_series", name: tab[:member].display_name) %>
            </p>
            <p class="text-xs text-secondary mt-2">
              <%= link_to t(".label_one_first"), bills_path(view: "paycheck"),
                    class: "text-primary hover:underline" %>
            </p>
          <% else %>
            <%# STATIC READ-ONLY paycheck readout. The
                config form is gone — the dialog reads the live plan's
                per-paycheck direct deposit rows (client-side from
                /plan/flow/graph) + the max-direct-deposit-connections note
                (server-rendered). No writes, no settlement-math changes. %>
            <h3 class="text-sm font-semibold text-primary">
              <%= t(".header", name: tab[:member].display_name) %>
            </h3>
            <p class="text-xs text-secondary mt-1">
              <%= t(".max_dd_label") %>:
              <%# Max direct deposit connections: the member's payroll income
                  series' plan_max_account_links (a series-level field).
                  Nil -> "Not Set". There is no such field on the account or
                  member; it lives on the income series. %>
              <span class="font-medium text-primary">
                <% if tab[:series].plan_max_account_links.present? %>
                  <%= tab[:series].plan_max_account_links %>
                <% else %>
                  <%= t(".max_dd_not_set") %>
                <% end %>
              </span>
            </p>

            <%# Read-only series context (display only). %>
            <div class="flex items-center justify-between rounded-lg bg-surface-inset px-3 py-2 text-xs text-secondary mt-3">
              <span>
                <%= t(".series_label") %>:
                <span class="text-primary font-medium"><%= tab[:series].name %></span>
              </span>
            </div>

            <%# The per-paycheck direct deposit table. The header is
                server-rendered; the tbody rows are filled client-side from
                /plan/flow/graph (one row per account this member's paycheck
                funds in the current plan, per-paycheck amounts; the leftover
                row carries the leftover icon + the computed value). The
                placeholder row is replaced by the controller. %>
            <table class="w-full text-sm mt-3 dd-review-table" data-paycheck-dd-table>
              <thead>
                <tr class="text-xs text-secondary border-b border-primary/20">
                  <th class="text-left font-medium py-1.5 pr-3"><%= t(".account_header") %></th>
                  <th class="text-right font-medium py-1.5"><%= t(".amount_header") %></th>
                </tr>
              </thead>
              <tbody data-paycheck-dd-member="<%= tab[:member].id %>" data-paycheck-dd-empty-text="<%= t(".no_rows") %>">
                <tr data-paycheck-dd-empty>
                  <td colspan="2" class="text-xs text-secondary py-2"><%= t(".no_rows") %></td>
                </tr>
              </tbody>
            </table>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
